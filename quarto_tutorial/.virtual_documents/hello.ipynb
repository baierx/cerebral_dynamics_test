





#| label: fig-polar
#| fig-cap: "A line plot on a polar axis"

import numpy as np
import matplotlib.pyplot as plt

r = np.arange(0, 2, 0.01)
theta = 4 * np.pi * r**2
fig, ax = plt.subplots(
  subplot_kw = {'projection': 'polar'} 
)
ax.plot(theta, r)
ax.set_rticks([0.5, 1, 1.5, 2])
ax.grid(True)
plt.show()





#| label: fig-x_y
#| fig-cap: "A line plot using the x and y coordinates"

x = r*np.sin(theta)
y = r*np.cos(theta)

fig, ax = plt.subplots(figsize=(5, 5))

ax.plot(x, y);
# ax.axis('off');



